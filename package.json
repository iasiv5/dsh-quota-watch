{
  "name": "@iasiv5/dsh-quota-watch",
  "version": "0.1.43",
  "description": "GLM/Copilot 额度快照胶囊、详情面板与可选侧栏卡，含额度窗口与重置时间，凭据由宿主解析。版本无关，详见仓库。",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.mjs",
    "lib/client.js",
    "docs/assets",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iasiv5/dsh-quota-watch"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "yaml": "^2.5.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/run-tests.mjs",
    "security:check": "node scripts/check-public-package.mjs",
    "prepack": "npm run build && npm run security:check"
  }
}
